# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库：开发环境使用 SQLITE_DB_PATH；生产环境必须提供 PostgreSQL URL
SQLITE_DB_PATH=backend/data/ai_story.db
DATABASE_URL=postgresql://ai_story:change-me@localhost:5432/ai_story
DATABASE_CONN_MAX_AGE=60

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_PUBSUB_URL=redis://localhost:6379/2

# 混合推理与本地 Runtime Agent
AI_ROUTER_V2_ENABLED=false
AI_ROUTER_V2_SHADOW_MODE=true
AI_ENFORCE_PAID_PROVIDER_GUARD=true
AI_WORK_ITEM_EVENTS_ENABLED=true
AI_DISTRIBUTED_RESOURCE_LEASES_ENABLED=true
AI_RUNTIME_ROOT=E:\AI\ai-story-runtime
AI_RUNTIME_AGENT_URL=http://127.0.0.1:9100
AI_RUNTIME_AGENT_TOKEN=replace-with-a-long-random-token
AI_INTERMEDIATE_RETENTION_DAYS=30
# 首次开启清理前必须先按手册完成备份与恢复演练
AI_ARTIFACT_CLEANUP_ENABLED=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Page Agent / OpenCode
AGENT_SERVER_BASE_URL=http://127.0.0.1:9002
AGENT_SERVER_USERNAME=opencode
AGENT_SERVER_PASSWORD=
MCP_ACCESS_TOKEN=
AGENT_MODEL_PROVIDER_ID=opencode
AGENT_MODEL_ID=big-pickle
AGENT_MODEL_VARIANT=
AGENT_REMOTE_AGENT_NAME=build
AGENT_SHOW_FREE_MODELS=false
