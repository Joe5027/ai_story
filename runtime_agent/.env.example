RUNTIME_AGENT_BEARER_TOKEN=replace-with-a-long-random-token
RUNTIME_AGENT_DB_PATH=./var/runtime-agent.sqlite3
RUNTIME_AGENT_ARTIFACTS_DIR=./var/artifacts
# 不设置时安全退回全 Mock registry；部署时指向复制并核验后的固定 TOML。
RUNTIME_AGENT_CONFIG_PATH=

# live 始终免鉴权；其余端点按以下两项决定。
RUNTIME_AGENT_ALLOW_UNAUTHENTICATED_LOOPBACK=true
RUNTIME_AGENT_REQUIRE_AUTH_NON_LOOPBACK=true

RUNTIME_AGENT_GPU_CAPACITY=1
RUNTIME_AGENT_CPU_MOTION_CAPACITY=2
RUNTIME_AGENT_POLL_INTERVAL_MS=20
